{
  "productName": "mini-sap-desktop",
  "version": "0.1.0",
  "identifier": "com.mini-sap.desktop",
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "permissions": ["fs:default", "dialog:default", "http:default", "notification:default", "log:default", "sql:default"]
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Mini SAP Desktop",
        "width": 800
      }
    ]
  }
}
