{
  "productName": "AuditApp",
  "version": "0.1.0",
  "identifier": "com.audit.app",
  "build": {
    "distDir": "../dist",
    "devPath": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
